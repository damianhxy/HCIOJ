<div class="box detail addproblem">
	<h2><i class="fa fa-calendar"></i>Create Contest</h2>
	<div>
		<form action="/addcontest" method="post">
			<input type="text" placeholder="Contest Title" name="title" class="aptitle" required/>
			<textarea placeholder="Contest Description" name="desc"></textarea>
			<input type="text" placeholder="Start Time: YYYY-MM-DD HH:MM(:SS)" name="start" class="" required/>
			<input type="text" placeholder="End Time: YYYY-MM-DD HH:MM(:SS)" name="end" class="" required/>
			<p><input type="checkbox" name="indi" id="indi"><label for="indi" class="checklabel"><span class="fakecheck"></span>&nbsp;&nbsp;Individual Timer?</label></p>
			<input type="number" min="0" max="500" placeholder="Time for each user in minutes (if individual timer)" name="time" value = "240" required/>
			<select name="problems" multiple>
				<option value="" disabled>Contest Problems: Hold Ctrl to select multiple</option>
				{{#if probs}}
				{{#each probs}}
				<option value="{{this.title}}">{{this.title}}</option>
				{{/each}}
				{{/if}}
			</select>
			<input type="submit" value="Add Contest">
		</form>
	</div>
</div>
