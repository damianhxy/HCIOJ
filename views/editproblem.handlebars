<div class="frame">
	<div class="bit-1">
		<div class="container">
			<div class="header">
				<i class="fa fa-cube"></i>
				<h2>{{title}} <small>{{subtitle}}</small></h2>
			</div>
		</div>
	</div>
</div>
<div class="frame">
	<div class="bit-2 left">
		<div class="container">
			<div class="header">
				<i class="fa fa-cube"></i>
				<h2>Contest Details <small>idek</small></h2>
			</div>
			<div>
				<form action="{{submit}}" method="post">
					<input type="text" placeholder="Problem Title" name="title" required/>
					<input type="text" placeholder="Problem Type (Batch, Output Only, etc.)" name="subtitle" required></input>
					<input type="text" placeholder="Input From" name="from"></input>
					<input type="text" placeholder="Output To" name="dest"></input>
					<input type="text" placeholder="HTML Statement URL" name="desc-html"></input>
					<input type="text" placeholder="Text Statement URL" name="desc-txt"></input>
					<input type="text" placeholder="PDF/Doc Statement URL" name="desc-doc"></input>
					<input type="text" placeholder="Misc. Files URLs (comma separated, no spaces)" name="desc-other"></input>
					<input type="submit" value="Add Problem">
				</form>
			</div>
		</div>
	</div>
	<div class="bit-2 right">
	</div>
</div>