<div class="frame">
	<div class="bit-1">
		<div class="container">
			<div class="header">
				<i class="fa fa-comment-o"></i>
				<h2>Hello, {{user.username}}!</h2>
			</div>
			<div>
				<div>
					Start solving some problems!
				</div>
			</div>
		</div>
	</div>
</div>
<div class="frame">
	<div class="left bit-2">
		{{!--<div class="container">--}}
		{{!--	<div class="header">--}}
		{{!--		<i class="fa fa-calendar"></i>--}}
		{{!--		<h2>Contest Calendar</h2>--}}
		{{!--	</div>--}}
		{{!--	<div>--}}
		{{!--		<div id="contestcalendar"></div>--}}
		{{!--	</div>--}}
		{{!--</div>--}}
		<div class="container">
			<div class="header">
				<i class="fa fa-rocket"></i>
				<h2>Glorious Creators of Best Judge</h2>
			</div>
			<div data-closed="true" style="max-height: 0px; overflow: hidden;">
				<div>
					Wang Zhi Jian - Noob person who got B for Econs<br><br>
					Gui Ming Jiang - Noob person who got 0 for NOI selection<br><br>
					Damian Ho - Noob person who didn't work<br><br>
					Ho Jiefeng - Noob in general
				</div>
			</div>
		</div>
		<div class="container">
			<div class="header">
				<i class="fa fa-certificate"></i>
				<h2>Your Submissions</h2>
			</div>
			<div>
				<table class="table">
					<thead>
						<tr>
							<th>ID</th>
							<th>Problem</th>
							<th>Submitted Date</th>
							<th>Runtime</th>
							<th>Language</th>
							<th>Score</th>
							<th>Progress</th>
						</tr>
					</thead>
					<tbody style="overflow: auto;" id="yourSubmissions">
						{{#each userSubmissions}}
						<tr>
							<td><a href="/submissions/{{this.numid}}">{{this.numid}}</a></td>
							<td><a href="/problems/{{this.problem}}">{{this.problem}}</a></td>
							<td>{{this.submitted_date}}</td>
							<td>{{this.runtime}}s</td>
							<td>{{this.language}}</td>
							<td><span class='score-{{{this.score}}}'>{{this.score}}</span></td>
							<td><span style='color: gray'>{{this.progress}}</span></td>
						</tr>
						{{/each}}
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<div class="right bit-2">
		<div class="container">
			<div class="header">
				<i class="fa fa-user"></i>
				<h2>Online Users</h2>
			</div>
			<div>
				<table id="onlineusers" class="table table-striped">
					<tbody>
						{{{generateOnline onlineUsers}}}
					</tbody>
				</table>
			</div>
		</div>
		<div class="container">
			<div class="header">
				<i class="fa fa-certificate"></i>
				<h2>Latest Submissions</h2>
			</div>
			<div>
				<table class="table">
					<thead>
						<tr>
							<th>ID</th>
							<th>User</th>
							<th>Problem</th>
							<th>Submitted Date</th>
							<th>Language</th>
							<th>Score</th>
							<th>Progress</th>
						</tr>
					</thead>
					<tbody style="overflow: auto;" id="submissions">
						{{#each submissions}}
						<tr>
							<td><a href="/submissions/{{this.numid}}">{{this.numid}}</a></td>
							<td><a href="/users/{{this.user}}">{{this.user}}</a></td>
							<td><a href="/problems/{{this.problem}}">{{this.problem}}</a></td>
							<td>{{this.submitted_date}}</td>
							<td>{{this.language}}</td>
							<td><span class='score-{{{this.score}}}'>{{this.score}}</span></td>
							<td><span style='color: gray'>{{this.progress}}</span></td>
						</tr>
						{{/each}}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<script>
	$(document).ready(function() {
		$("#contestcalendar").fullCalendar({
			{{#if events}}events: {{{events}}} {{/if}},
			aspectRatio: 1,
			//eventBackgroundColor: "#FA6900",
			//eventBorderColor: "#FA6900"
		});
	});
</script>
<script src="/js/submission.js"></script>