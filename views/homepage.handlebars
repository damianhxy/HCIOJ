<div class="frame">
	<div class="bit-1">
		<div class="container">
			<div class="header">
				<i class="fa fa-comment-o"></i>
				<h2>Hello, {{user.realname}}!</h2>
			</div>
			<div>
				<div>
					Start solving some problems!
				</div>
			</div>
		</div>
	</div>
</div>
<div class="frame">
	<div class="left bit-2">
		<div class="container">
			<div class="header">
				<i class="fa fa-calendar"></i>
				<h2>Contest Calendar</h2>
			</div>
			<div>
				<div id="contestcalendar"></div>
			</div>
		</div>
	</div>
	<div class="right bit-2">
		<div class="container">
			<div class="header">
				<i class="fa fa-user"></i>
				<h2>Online Users</h2>
			</div>
			<div>
				<table id="onlineusers" class="table table-striped">
					<tbody>
						{{{generateOnline onlineUsers}}}
					</tbody>
				</table>
			</div>
		</div>
		<div class="container">
			<div class="header">
				<i class="fa fa-certificate"></i>
				<h2>Latest Submissions</h2>
			</div>
			<div>
				<table class="table">
					<thead>
						<tr>
							<th>ID</th>
							<th>User</th>
							<th>Problem</th>
							<th>Time</th>
							<th>Progress</th>
							<th>Score</th>
						</tr>
					</thead>
					<tbody style="overflow: auto;">
						{{#each submissions}}
						<tr>
							<td><a href="/submissions/{{this.numid}}">{{this.numid}}</a></td>
							<td><a href="/users/{{this.user}}">{{this.user}}</a></td>
							<td><a href="/problems/{{this.title}}">{{this.title}}</a></td>
							<td>{{this.time}}</td>
							<td><span style='color: gray'>{{this.progress}}</span></td>
							<td><span class='label label-{{{scoreColour this.score}}}'>{{this.score}}</span></td>
						</tr>
						{{/each}}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<script>
	$(document).ready(function() {
		$("#contestcalendar").fullCalendar({
			{{#if events}}events: {{{events}}} {{/if}},
			aspectRatio: 1,
			//eventBackgroundColor: "#FA6900",
			//eventBorderColor: "#FA6900"
		});
	});
</script>