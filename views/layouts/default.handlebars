<body>
	<header class="box">
		<a href="/"><!--img class="logo" src="/img/logo.png"-->
			<h1 class="logo"><i class="fa fa-legal"></i> judgement<span>al</span></h1>
		</a>
		{{#if user}}
			<div class="header-avatar pull-right">
				<img src="{{user.avatar}}">&nbsp;
				<a id="profile" href="/users/{{user.username}}">{{user.username}}</a>
				<p class="pull-right login-prompt"><a href="/logout"> Logout </a></p>
				<div class="header-divider pull-right"></div>
			</div>
			<div class="header-divider pull-right"></div>
			<div class="dropdown pull-right">
				<a href="#" id="header-notif">
				<i class="fa fa-circle header-notif-circle"></i>
				<p class="header-notif-count">99</p>
				<i class="fa fa-bell-o header-notif-bell"></i>
				</a>
			</div>
		{{else}}
			<p class="pull-right login-prompt"><a href="/signin">Sign In</a> or <a href="/signup">Signup</a></p>
		{{/if}}
