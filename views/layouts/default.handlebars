	<div class="content-head">
	<div class="box">
		<form class="form-inline" style="padding: 0" method="GET" action="/search">
			<span class="search">
				<input class="form-control" placeholder="Search Problems" name="query" type="search">
				<i class="fa fa-search" onclick="document.forms[0].submit();"></i>
			</span>
		</form>
		<span class="content-info">
			<h3>{{{title}}}</h3>
			<p>{{{subtitle}}}{{#if problem}}, {{problem.from}}/{{problem.dest}}{{/if}}</p>
			{{#if prob}}<p>{{prob.status}}</p>{{/if}}
		</span>
		{{#if problem.tags}}
		<hr><ul class="problem-tags">
		{{#each problem.tags}}
			<li><a class="label" href="/search?query={{this}}">{{this}}</a>
		{{/each}}
		</ul>
		{{/if}}
	</div>
	</div>

	<div class="content problem">
	{{#if error}}
		<p class="alert alert-danger noselect"><i class="fa fa-warning"></i>&nbsp;&nbsp;&nbsp;{{error}}</p>
	{{/if}}

	{{#if success}}
		<p class="alert alert-success noselect"><i class="fa fa-rocket"></i>&nbsp;&nbsp;&nbsp;{{success}}</p>
	{{/if}}

	{{#if notice}}
		<p class="alert alert-warning"><i class="fa fa-warning"></i>&nbsp;&nbsp;&nbsp;{{notice}}</p>
	{{/if}}
		{{{body}}}
	</div>

	{{#if problem}}
		<div class="problem-sidebar">
		<h5>NAV</h5>
		<ul class="nav" role="tablist">
			<li><a href="#p-desc"><i class="fa fa-file-text"></i></a></li>
			{{#if problem.input}}<li><a href="#p-io"><i class="fa fa-sign-in"></i></a></li>{{/if}}
			{{#if problem.subtasks}}<li><a href="#p-limits"><i class="fa fa-tasks"></i></a></li>{{/if}}
			{{#if problem.samples}}<li><a href="#p-tcs"><i class="fa fa-retweet"></i></a></li>{{/if}}
			{{#if problem.clarifications}}<li><a href="#p-clarifications"><i class="fa fa-question-circle"></i></a></li>{{/if}}
			<li><a href="#p-submit"><i class="fa fa-code"></i></a></li>
			<li><a href="#p-subs"><i class="fa fa-list"></i></a></li>
		</ul>
		</div>
	{{/if}}
	<footer>
		<div class="copyright box">
			&copy; 2014 ~ 2015 <i class="fa fa-legal"></i> judgemental
		</div>
		<div class="team box">
			<!--MADE BY
			<br><span></span>-->
