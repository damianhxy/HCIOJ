	</main>
	<script>
		window.addEventListener("load", function(){
			Array.prototype.forEach.call(document.querySelectorAll(".header"), function(item, counter) {
				item.addEventListener("click",function() {
					var n = this.parentElement.children[1]
					if(n.dataset.closed!="true") {
						n.style.maxHeight = "0";
						n.style.overflow = "hidden";
						n.dataset.closed = "true";
					}
					else {
						n.style.maxHeight = "";
						n.style.overflow = ""
						n.dataset.closed = "false";
					}
				});
			});
		});
	</script>
