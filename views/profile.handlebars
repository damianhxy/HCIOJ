<div class="frame">
    <div class="bit-2 left"> <!-- Note: .left is for the margin-bottom -->
        <div class="container">
            <div class="header">
                <i class="fa fa-user"></i>
                <h2>User Information</h2>
            </div>
            <div>
                <table class="table">
                    <tbody>
                        <tr><td>Profile Picture</td><td><img src="{{profile.avatar}}" style="border-radius:50%;" height="50px"></td></tr>
                        <tr><td>Username</td><td>{{profile.username}}</td></tr>
                        <tr><td>Real Name</td><td>{{profile.realname}}</td></tr>
                        <tr><td>Email</td><td>{{profile.email}}</td></tr>
                        <!--tr><td>Level</td><td>{{profile.level}}</td></tr-->
                        <tr><td>Total Points</td><td>{{profile.score}}</td></tr>
                        <!--tr><td>Admin</td><td>{{profile.admin}}</td></tr-->
                        <tr><td>Ranking</td><td>{{ranking}}</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="bit-2 right">
        <div class="container">
            <div class="header">
                <i class="fa fa-tachometer"></i>
                <h2>Competition Performance</h2>
            </div>
            <div id="contestperf" class="table-responsive collapse in">
                <table class="table">
                    <thead>
                        <th>Contest</th>
                        <th>Score</th>
                    </thead>
                    <tbody>
                        {{#each profile.contests}}
                            <tr><td><a href='/contests/{{this.id}}'>{{@key}}</a></td><td>{{this.score}} / {{this.total}}</td></tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="container">
            <div class="header">
                <i class="fa fa-certificate"></i>
                <h2>Latest Submissions</h2>
            </div>
            <div>
                <table class="table">
                    <thead>
                        <th>ID</th>
                        <th>Problem</th>
                        <th>Submitted Date</th>
                        <th>Language</th>
                        <th>Score</th>
                        <th>Progress</th>
                    </thead>
                    <tbody id="userSubmissions">
                        {{#each submissions}}
                        <tr>
                            <td><a href="/submissions/{{this.numid}}">{{this.numid}}</a></td>
                            <td><a href="/problems/{{this.problem}}">{{this.problem}}</a></td>
                            <td>{{this.submitted_date}}</td>
                            <td>{{this.language}}</td>
                            <td><span class="score score-{{this.score}}">{{this.score}}</span></td>
                            <td><span style='color: gray'>{{this.progress}}</span></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
    var thisusername = "{{profile.username}}";
</script>
<script src="/js/user.js"></script>