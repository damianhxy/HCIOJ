<div class="problem-full row">
    <div class="detail col-md-6 problem-hleft problem-table">
        <h2 data-toggle="collapse" data-target="#userinfo"><i class="fa fa-user"></i>User Information</h2>
        <div id="userinfo" class="table-responsive collapse in" style="max-height: none;">
            <table class="table table-striped">
                <tbody>
                    <!--tr><td>Username</td><td>{{profile.username}}</td></tr>
                    <tr><td>Real Name</td><td>{{profile.realname}}</td></tr-->
                    <tr><td>Email</td><td>{{#if user}}{{profile.email}}{{else}}(Hidden){{/if}}</td></tr>
                    <!--tr><td>Level</td><td>{{profile.level}}</td></tr-->
                    <tr><td>Total Points</td><td>{{profile.score}}</td></tr>
                    <!--tr><td>Admin</td><td>{{profile.admin}}</td></tr-->
                    <tr><td>Ranking</td><td>{{ranking}}</td></tr>
                    <tr><td>Profile Picture</td><td><img src="{{profile.avatar}}" style="border-radius:50%;"></td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="detail col-md-6 problem-hright problem-table">
        <h2 data-toggle="collapse" data-target="#contestperf"><i class="fa fa-tachometer"></i>Competition Performance</h2>
        <div id="contestperf" class="table-responsive collapse in">
            <table class="table table-striped">
                <thead>
                    <th>Contest</th>
                    <th>Score</th>
                </thead>
                <tbody>
                    {{#each profile.contests}}
                        <tr><td><a href='/contests/{{this.id}}'>{{@key}}</a></td><td>{{this.score}} / {{this.total}}</td></tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <div class="detail table-responsive">
        <table class="table table-striped">
            <thead>
                <th colspan="5">Latest Submissions</th>
            </thead>
            <thead>
                <th>ID</th>
                <th>Problem</th>
                <th>Time</th>
                <th>Progress</th>
                <th>Score</th>
            </thead>
            <tbody>
                {{#each userSubmissions}}
                <tr>
                    <td><a href="/submissions/{{this.numid}}">{{this.numid}}</a></td>
                    <td><a href="/problems/{{this.title}}">{{this.title}}</a></td>
                    <td>{{this.time}}</td>
                    <td>Graded</td>
                    <td><span class="score score-{{this.score}}">{{this.score}}</span></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>