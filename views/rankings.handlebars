<div class="container">
	<div class="header">
		<i class="fa fa-trophy"></i>
		<h2>Ranking</h2>
	</div>
	<div class="nopad">
		<table class="table">
			<thead>
				<th>#</th>
				<th>Username</th>
				<th>Score</th>
				<th>Accepted</th>
				<th>Partial</th>
				<th>Failed</th>
			</thead>
			<tbody>
				{{#each list}}
				<tr>
					<td>{{this.rank}}</td>
					<td><a href="/users/{{this.username}}">{{this.username}}</a></td>
					<td>{{this.score}}</td>
					<td>{{this.accepted.length}}</td>
					<td>{{this.partial.length}}</td>
					<td>{{this.failed.length}}</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
	</div>
</div>