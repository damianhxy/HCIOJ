<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta content="IE=edge" http-equiv="X-UA-Compatible">
	<meta content="width=device-width, initial-scale=1.0,
	maximum-scale=1.0,user-scalable=no" name="viewport">
	<title>Sign In</title>
	<link href="/img/favicon.ico" rel="shortcut icon" type="image/x-icon">
	<link href='https://fonts.googleapis.com/css?family=Amatic+SC|Lato:400,700' rel='stylesheet' type='text/css'>
	<link href="/css/main.css" rel="stylesheet">
	<link href="/css/font-awesome.min.css" rel="stylesheet">
	<link href="/css/main.css" rel="stylesheet">
</head>
<body>
	{{#if success}}
		<p class="alert alert-success"><i class="fa fa-rocket"></i>&nbsp;&nbsp;&nbsp;{{success}}</p>
	{{/if}}
	{{#if error}}
		<p class="alert alert-danger"><i class="fa fa-warning"></i>&nbsp;&nbsp;&nbsp;{{error}}</p>
	{{/if}}
	<div class="login-container">
		<div class="login">
			<div class="login-head">
				<span class="logo">:I</span>
				<span class="title">Sign In</span>
			</div>
			<form action="/signin" method="post">
				<input type="text" placeholder="Username" name="username" required autofocus/>
				<input type="password" placeholder="Password" name="password" required/>
				<input type="submit" value="Sign In">
			</form>
			<a href="/signup" class="alt-button">Make a New Account</a>
	</div>
