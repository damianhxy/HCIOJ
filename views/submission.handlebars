<div class="frame">
	<div class="bit-1">
		<div class="container">
			<div class="header">
				<i class="fa fa-cube"></i>
				<h2>{{{title}}} <small>{{{subtitle}}}</small></h2>
			</div>
		</div>
	</div>
</div>

<form method="post" action="/submit/{{submission.title}}" id="submitform">
<div class="frame">
	<div class="bit-2 left">
		<div class="container">
			<div class="header">
				<i class="fa fa-info-circle"></i>
				<h2>Submission Info</h2>
			</div>
			<div>
				<table class="table table-striped table-bordered">
					<tr><td>Verdict</td><td>{{submission.verdict}} ({{submission.score}}%)</td></tr>
					<tr><td>Language</td><td id="language">{{submission.language}}</td></tr>
					<tr><td>Time</td><td>{{submission.time}}</td></tr>
					<tr><td>Runtime</td><td>{{submission.runtime}}s</td></tr>
					<tr><td>Contest</td><td>{{{getContest submission.contest}}}</td></tr>
				</table>
			</div>
		</div>
		<div class="container">
			<div class="header">
				<i class="fa fa-spinner"></i>
				<h2>Compile Status</h2>
			</div>
			<div>
				<div class="monospace">	
					{{submission.compile}}
				</div>
			</div>
		</div>
		
		{{#if isOwner}}
		<div class="container">
			<div class="header">
				<i class="fa fa-cog"></i>
				<h2>Compile Options</h2>
			</div>
			<div>
				<div class="compiler">
					<label>Language</label>
					<select name="language" class="alt-select">
						<option value="C++11">C++11 (4.9.2)</option>
						<option value="Pascal">Pascal (2.6.4)</option>
						<option value="Java">Java (1.7.0)</option>
						<option value="Python">Python (3.4.3)</option>
					</select>
					<br>
					<label>Compile Options</label>
					<pre></pre>
				</div>
			</div>
		</div>
		{{/if}}
		
		{{#if isViewable}}
		<div class="container">
			<div class="header">
				<i class="fa fa-code"></i>
				<h2>Edit Submission</h2>
			</div>
			<div>
				<div id="editor"></div>
				<input type="hidden" name="prob" value="{{submission.title}}">
				<button id="submitbutton">Submit For Grading</button>
			</div>
		</div>
		{{/if}}
		</form>
	</div>
	
	<div class="bit-2 right">
		{{#each submission.res}}
		<div class="container">
			<div class="header">
				<i class="fa fa-tasks"></i>
				<h2>Subtask {{this.num}} ({{this.score}} / {{this.maxscore}})</h2>
			</div>
			<div>
				<table class="table table-striped table-bordered">
					<thead>
						<tr>
							<th>#</th>
							<th>Message</th>
							<th>Score</th>
							<th>Time</th>
							<th>Memory</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						{{#each this.tcs}}
						<tr class="{{scoreColour this.score}}">
							<td>{{this.num}}</td>
							<td>{{this.msg}}</td>
							<td>{{this.score}}</td>
							<td>{{this.exec}}/{{this.wall}}</td>
							<td>{{this.ram}} MB</td>
							<td>{{{getStat this.stat}}}</td>
						</tr>
						{{/each}}
					</tbody>
				</table>
			</div>
		</div>
		{{/each}}
	</div>
</div>
</form>

{{#if isViewable}}
<script>
	(function() {
		var editor = ace.edit("editor");
		editor.setTheme("ace/theme/monokai");
		function compileOptions(override) {
			var t = override || $("select option:selected").val();
			if (override) $("select").val(override);
			if (t === "C++11") {
				$(".compiler pre").html("g++ ans.cpp -o {{submission.title}} -O2 -std=c++0x");
				editor.getSession().setMode("ace/mode/c_cpp");
			}
			else if (t === "Pascal") {
				$(".compiler pre").html("fpc ans.pas -o {{submission.title}} -O2");
				editor.getSession().setMode("ace/mode/pascal");
			}
			else if (t === "Java") {
				$(".compiler pre").html("javac ans.java");
				editor.getSession().setMode("ace/mode/java");
			}
			else if (t === "Python") {
				$(".compiler pre").html("python -m py_compile script.py");
				editor.getSession().setMode("ace/mode/python");
			}
		}
		$(document).ready(function() {
			compileOptions($("#language").text());
		});
		$("[name='language']").change(function() {
			compileOptions();
		});
		if (jQuery.browser.mobile)
			$("#editor").remove();
		else {
			$("#mobileeditor").hide();
			{{#if isOwner}}
			$("#submitbutton").click(function() {
				$("#mobileeditor").val(editor.getValue());
				$("#submitform").submit();
			});
			{{/if}}
		}
	})();
</script>
{{/if}}
