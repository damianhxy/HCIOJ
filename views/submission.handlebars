<div class="frame">
	<div class="bit-1">
		<div class="container">
			<div class="header">
				<i class="fa fa-cube"></i>
				<h2>{{{title}}} <small>{{{subtitle}}}</small></h2>
			</div>
		</div>
	</div>
</div>

<form method="post" action="/submit/{{submission.title}}" id="submitform">
<div class="frame">
	<div class="bit-2 left">
		<div class="container">
			<div class="header">
				<i class="fa fa-info-circle"></i>
				<h2>Submission Info</h2>
			</div>
			<div>
				<table class="table table-striped table-bordered">
					<tr><td>Verdict</td><td>{{submission.verdict}} ({{submission.score}}%)</td></tr>
					<tr><td>Language</td><td id="language">{{submission.language}}</td></tr>
					<tr><td>Time</td><td>{{submission.time}}</td></tr>
					<tr><td>Runtime</td><td>{{submission.runtime}}s</td></tr>
					<tr><td>Contest</td><td>{{{getContest submission.contest}}}</td></tr>
				</table>
			</div>
		</div>
		<div class="container">
			<div class="header">
				<i class="fa fa-spinner"></i>
				<h2>Compile Status</h2>
			</div>
			<div>
				<div class="monospace">	
					{{submission.compile}}
				</div>
			</div>
		</div>
		
		{{#if isOwner}}
		<div class="container">
			<div class="header">
				<i class="fa fa-cog"></i>
				<h2>Compile Options</h2>
			</div>
			<div>
				<div class="compiler">
					<label>Language</label>
					<select name="language" class="alt-select">
						<option value="C++11">C++11 (4.9.2)</option>
						<option value="Pascal">Pascal (2.6.4)</option>
						<option value="Java">Java (1.7.0)</option>
						<option value="Python">Python (3.4.3)</option>
					</select>
					<br>
					<label>Compile Options</label>
					<pre></pre>
				</div>
			</div>
		</div>
		{{/if}}
		
		{{#if isViewable}}
		<div class="container">
			<div class="header">
				<i class="fa fa-code"></i>
				<h2>Edit Submission</h2>
			</div>
			<div class="submitbox">
				<div class="selector">
					{{!--<i class="fa fa-arrow-left"></i>--}}
					{{!--<span>Loading</span>--}}
					{{!--<i class="fa fa-arrow-right"></i>--}}
					<span><i class="fa fa-cog fa-spin"></i></span>
					{{!--<span class="right">--}}
					{{!--	{{#if problem.files}}<i class="fa fa-arrow-left"></i>--}}
					{{!--	<i class="fa fa-arrow-right"></i>{{/if}}--}}
					{{!--	<i class="fa fa-upload"></i>--}}
					{{!--</span>--}}
				</div>
				<div id="editor">{{submission.code}}</div>
				{{#if problem.files}}{{#each problem.files}}<textarea id="{{this.name}}" name="{{this.name}}"></textarea>{{/each}}
				{{else}}<textarea id="ans" name="code"></textarea>{{/if}}
				{{!--<input type="hidden" name="prob" value="{{problem.title}}">--}}
				<button id="submitbutton">Submit For Grading</button>
			</div>
		</div>
		{{/if}}
		</form>
	</div>
	
	<div class="bit-2 right">
		{{#each submission.res}}
		<div class="container">
			<div class="header">
				<i class="fa fa-tasks"></i>
				<h2>Subtask {{this.num}} ({{this.score}} / {{this.maxscore}})</h2>
			</div>
			<div>
				<table class="table table-striped table-bordered">
					<thead>
						<tr>
							<th>#</th>
							<th>Message</th>
							<th>Score</th>
							<th>Time</th>
							<th>Memory</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						{{#each this.tcs}}
						<tr class="{{scoreColour this.score}}">
							<td>{{this.num}}</td>
							<td>{{this.msg}}</td>
							<td>{{this.score}}</td>
							<td>{{this.exec}}/{{this.wall}}</td>
							<td>{{this.ram}} MB</td>
							<td>{{{getStat this.stat}}}</td>
						</tr>
						{{/each}}
					</tbody>
				</table>
			</div>
		</div>
		{{/each}}
	</div>
</div>
</form>

{{#if isViewable}}
<script>
	window.addEventListener("load", function(){
		var files = {{#if problem.files}}{{{json problem.files}}}{{else}}[{name:"ans",text:false}]{{/if}};
		var languages = {
			"cpp":{
				"name":"C++11 (4.9.2)",
				"mode":"c_cpp",
				"def":"#include <bits/stdc++.h>\r\nusing namespace std;\r\n\r\nint main() {\r\n\t/* Your Code Here */\r\n\treturn 0;\r\n}",
				"compiler":"g++ replace.cpp -o replace -O2 -std=c++0x",
				"cursor": {row: 4, column: 1}
			},
			"pas":{
				"name":"Pascal (2.6.4)",
				"mode":"pascal",
				"def":"program replace;\r\n\r\nBegin\r\n\t(* Your Code Here *)\r\nEnd.",
				"compiler":"fpc replace.pas -o replace -O2",
				"cursor": {row: 3, column: 1}
			},
			"java":{
				"name":"Java (1.7.0)",
				"mode":"java",
				"def":"import java.util.*;\r\nimport java.lang.*;\r\nimport java.io.*;\r\n\nclass {{this.title}} {\r\n\tpublic static void main(String[] args) {\r\n\t\t/* Your Code Here */\r\n\t}\r\n}",
				"compiler":"javac replace.java",
				"cursor": {row: 6, column: 2}
			},
			"py":{
				"name":"Python (3.4.3)",
				"mode":"python",
				"def":"# Your Code Here\n",
				"compiler":"python replace.py",
				"cursor": {row: 2, column: 0}
			}
		};
		var editor = ace.edit("editor");
	 	editor.setTheme("ace/theme/monokai");
		editor.$blockScrolling = Infinity;
		var position = 0, extension = "cpp";

		function update() {
			var x = document.querySelector(".selector>span");
			if(files[position].text) {
				x.textContent = files[position].name;
				editor.getSession().setMode("ace/mode/plain_text");
				editor.setValue(document.querySelector("#"+files[position].name).value || "");
			}
			else {
				x.textContent = files[position].name + "." + extension;
				editor.getSession().setMode("ace/mode/"+languages[extension].mode);
				if(files[position].def) editor.setValue(document.querySelector("#"+files[position].name).value || files[position].def[extension] || languages[extension].def);
				else editor.setValue(document.querySelector("#"+files[position].name).value || languages[extension].def);
				editor.moveCursorToPosition(languages[extension].cursor);
			}
		}

		document.querySelector(".selector>span").textContent = files[position].name + "." + extension;
		editor.getSession().setMode("ace/mode/"+languages[extension].mode);
		document.querySelector(".compiler pre").textContent = languages[extension].compiler.replace(new RegExp("replace", 'g'), files[0].name);

		if(document.querySelector(".selector .fa-arrow-left")){
			document.querySelector(".selector .fa-arrow-left").addEventListener("click", function() {
				document.querySelector("#"+files[position].name).value = editor.getValue();
				position += (files.length - 1);
				position %= files.length;
				update();
			});
			document.querySelector(".selector .fa-arrow-right").addEventListener("click", function() {
				document.querySelector("#"+files[position].name).value = editor.getValue();
				position++;
				position %= files.length;
				update();
			});
		}

		document.getElementById("language").addEventListener("change", function() {
			extension = this.value;
			document.querySelector(".compiler pre").textContent = languages[this.value].compiler.replace(new RegExp("replace", 'g'), files[0].name);
			files.forEach(function(item){
				document.querySelector("#"+item.name).value = "";
			});
			update();
		});

		document.getElementById("submitbutton").addEventListener("click", function() {
			document.querySelector("#"+files[position].name).value = editor.getValue();
			document.getElementById("submitform").submit();
		});
	});
</script>
{{/if}}
